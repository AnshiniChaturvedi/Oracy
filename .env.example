# Copy to .env and fill in locally. Never commit real values.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_RESUME_UPLOAD_MB=
MAX_AUDIO_UPLOAD_MB=
MAX_VIDEO_UPLOAD_MB=

# --- Database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=oracy_db

# --- File storage (local | s3) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM provider (optional: openai | gemini) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY / OPENAI_MODEL or GEMINI_API_KEY / GEMINI_MODEL are also accepted.
# LLM_BASE_URL= (optional custom base URL)

# --- ML / speech / vision (optional) ---
WHISPER_MODEL_SIZE=
SENTENCE_TRANSFORMER_MODEL=
MODEL_CACHE_DIR=./models_cache

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
